<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="tank_world">

    <!-- ============================================ -->
    <!--                  PHYSICS                     -->
    <!-- ============================================ -->
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ============================================ -->
    <!--              REQUIRED SYSTEM PLUGINS         -->
    <!-- ============================================ -->
    <!-- Physics engine -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <!-- Sensor rendering (LIDAR, IMU, camera) -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Scene broadcasting (needed for GUI if ever used) -->
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- User commands (spawn, delete, etc.) -->
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <!-- ============================================ -->
    <!--               GROUND + LIGHT                 -->
    <!-- ============================================ -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================ -->
    <!--            SOME WALLS TO SCAN                -->
    <!-- ============================================ -->
    <!-- Simple obstacles so the LIDAR has something  -->
    <!-- to see and SLAM has features to work with.   -->

    <model name="wall_north">
      <static>true</static>
      <pose>3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>-3 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>0 3 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>0 -3 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.15 1.0</size></box></geometry>
          <material><ambient>0.6 0.3 0.1 1</ambient><diffuse>0.6 0.3 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A box obstacle in the room -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>1.5 1.0 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><ambient>0.2 0.5 0.2 1</ambient><diffuse>0.2 0.5 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- A cylinder obstacle -->
    <model name="obstacle_cylinder">
      <static>true</static>
      <pose>-1.0 1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.5 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>


    <!-- ============================================ -->
    <!--                  TANK MODEL                  -->
    <!-- ============================================ -->
    <model name="my_tank">
      <pose>0 0 0.05 0 0 0</pose>

      <!-- ======== BASE LINK (chassis) ======== -->
      <link name="base_link">
        <inertial>
          <pose>0.0115 0 0.004 0 0 0</pose>
          <mass>1.02</mass>
          <inertia>
            <ixx>0.00283</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00301</iyy><iyz>0</iyz>
            <izz>0.00554</izz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0.0115 0 0.004 0 0 0</pose>
          <geometry><box><size>0.1833 0.1776 0.0423</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <pose>0.0115 0 0.004 0 0 0</pose>
          <geometry><box><size>0.1833 0.1776 0.0423</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- Platform (visual only, merged into base_link) -->
        <visual name="platform_visual">
          <pose>0 0 0.082 0 0 0</pose>
          <geometry><box><size>0.2 0.152 0.002</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>

        <!-- LIDAR housing (visual only) -->
        <visual name="lidar_housing_visual">
          <pose>0.05 0 0.112 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>

        <!-- IMU sensor (attached to base_link) -->
        <sensor name="imu_sensor" type="imu">
          <pose>0 0 0.078 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <topic>imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>

      <!-- ======== LIDAR LINK ======== -->
      <link name="lidar_link">
        <pose relative_to="base_link">0.05 0 0.112 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00001</iyy><iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <sensor name="lidar_sensor" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>6</update_rate>
          <topic>scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>720</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.12</min>
              <max>8.0</max>
              <resolution>0.01</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </lidar>
        </sensor>
      </link>
      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>

      <!-- ======== LEFT DRIVE WHEEL ======== -->
      <link name="left_drive">
        <pose relative_to="base_link">-0.0579 0.068 0.001 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000016</iyy><iyz>0</iyz>
            <izz>0.000016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_drive_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_drive</child>
        <axis><xyz>0 0 1</xyz><limit><effort>5</effort></limit></axis>
      </joint>

      <!-- ======== RIGHT DRIVE WHEEL ======== -->
      <link name="right_drive">
        <pose relative_to="base_link">0.058 -0.068 0.001 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000016</iyy><iyz>0</iyz>
            <izz>0.000016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_drive_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_drive</child>
        <axis><xyz>0 0 1</xyz><limit><effort>5</effort></limit></axis>
      </joint>

      <!-- ======== LEFT BEARING WHEEL ======== -->
      <link name="left_bearing">
        <pose relative_to="base_link">0.058 0.0686 0.001 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000016</iyy><iyz>0</iyz>
            <izz>0.000016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="left_bearing_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_bearing</child>
        <axis><xyz>0 0 1</xyz><limit><effort>5</effort></limit></axis>
      </joint>

      <!-- ======== RIGHT BEARING WHEEL ======== -->
      <link name="right_bearing">
        <pose relative_to="base_link">-0.058 -0.069 0.001 -1.5708 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.000016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000016</iyy><iyz>0</iyz>
            <izz>0.000016</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.019</radius><length>0.023</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="right_bearing_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_bearing</child>
        <axis><xyz>0 0 1</xyz><limit><effort>5</effort></limit></axis>
      </joint>

      <!-- ======== DIFF DRIVE PLUGIN ======== -->
      <plugin filename="ignition-gazebo-diff-drive-system"
              name="ignition::gazebo::systems::DiffDrive">
        <left_joint>left_drive_joint</left_joint>
        <left_joint>left_bearing_joint</left_joint>
        <right_joint>right_drive_joint</right_joint>
        <right_joint>right_bearing_joint</right_joint>
        <wheel_separation>0.136</wheel_separation>
        <wheel_radius>0.019</wheel_radius>
        <max_linear_acceleration>2.0</max_linear_acceleration>
        <topic>cmd_vel</topic>
        <odom_topic>odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <tf_topic>tf</tf_topic>
      </plugin>

      <!-- ======== IMU PLUGIN ======== -->
      <plugin filename="ignition-gazebo-imu-system"
              name="ignition::gazebo::systems::Imu"/>

    </model>

  </world>
</sdf>
