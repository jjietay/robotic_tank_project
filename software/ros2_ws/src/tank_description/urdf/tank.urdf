        <child link="lidar_standoff_rl"/>
        <origin xyz="0.015 0.025 0.015"/>
    </joint>

    <link name="lidar_standoff_rr">
        <visual>
        <geometry><cylinder radius="0.002" length="0.026"/></geometry>
        <material name="silver"><color rgba="0.15 0.15 0.15 1.0"/></material>
        </visual>
    </link>
    <joint name="lidar_standoff_rr_joint" type="fixed">
        <parent link="platform"/>
        <child link="lidar_standoff_rr"/>
        <origin xyz="0.015 -0.025 0.015"/>
    </joint>



<!-- ================================================ -->
<!--                     LIDAR                        -->
<!-- ================================================ -->

    <link name="lidar_link">
        <visual>
        <origin xyz="0.00 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="package://tank_description/meshes/YDLIDAR_X3Pro.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="blue">
            <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
        </visual>

        <!-- Gazebo needs collision + inertial on sensor links -->
        <collision>
            <geometry><cylinder radius="0.035" length="0.03"/></geometry>
        </collision>
        <inertial>
            <mass value="0.05"/>
            <inertia ixx="0.00001" ixy="0" ixz="0"
                     iyy="0.00001" iyz="0" izz="0.00001"/>
        </inertial>
    </link>
    <joint name="lidar_joint" type="fixed">
        <parent link="platform"/>
        <child link="lidar_link"/>
        <origin xyz="-0.05 0 0.03"/>
    </joint>




<!-- ================================================ -->
<!--                  DRIVE WHEELS                    -->
<!-- ================================================ -->

<!-- ============== LEFT ================== -->
<link name="left_drive">
    <visual>
    <geometry>
        <cylinder radius="0.019" length="0.023"/>
    </geometry>
    <material name="light_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    </visual>
    <collision>
        <geometry><cylinder radius="0.019" length="0.023"/></geometry>
    </collision>
    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.000016" ixy="0.0" ixz="0.0"
            iyy="0.000016" iyz="0.0" izz="0.000016"/>
    </inertial>
</link>
<joint name="left_drive_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_drive"/>
    <origin xyz="-0.0579 0.068 0.001" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
</joint>


<!-- ============== RIGHT ================== -->
<link name="right_drive">
    <visual>
    <geometry>
        <cylinder radius="0.019" length="0.023"/>
    </geometry>
    <material name="light_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    </visual>
    <collision>
        <geometry><cylinder radius="0.019" length="0.023"/></geometry>
    </collision>
    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.000016" ixy="0.0" ixz="0.0"
            iyy="0.000016" iyz="0.0" izz="0.000016"/>
    </inertial>
</link>
<joint name="right_drive_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_drive"/>
    <origin xyz="0.058 -0.068 0.001" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
</joint>



<!-- ================================================ -->
