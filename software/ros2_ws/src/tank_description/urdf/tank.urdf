<?xml version="1.0"?>
<robot name="my_tank">

<!-- ================================================ -->
<!--                   BASE LINK                      -->
<!-- ================================================ -->

    <link name="base_link">
        <visual>
        <origin xyz="0 0 0" rpy="3.14 0 1.57"/>
        <geometry>
            <mesh filename="package://tank_description/meshes/new_chassis.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black">
            <color rgba="0.025 0.025 0.025 1.0"/>
        </material>
        </visual>

        <collision>
            <origin xyz="0.0115 0 0.004" rpy="0 0 0"/>
            <geometry>
                <box size="0.1833 0.1776 0.0423"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.0115 0 0.004" rpy="0 0 0"/>
            <mass value="1.02"/>
            <inertia
                ixx="0.00283" ixy="0.0" ixz="0.0"
                iyy="0.00301" iyz="0.0" izz="0.00554"/>
        </inertial>
    </link>


<!-- ================================================ -->
<!--                    IMU LINK                      -->
<!-- ================================================ -->

    <link name="imu_link"/>
    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0.00 0 0.078" rpy="0 0 0"/>
    </joint>




<!-- ================================================ -->
<!--     CHASSIS → PLATFORM STANDOFFS (4 per side)    -->
<!-- ================================================ -->

<!-- ============== LEFT ================== -->

    <link name="standoff_l2">
        <visual>
        <geometry><cylinder radius="0.0025" length="0.05"/></geometry>
        <material name="silver"><color rgba="0.15 0.15 0.15 1.0"/></material>
        </visual>
    </link>
    <joint name="standoff_l2_joint" type="fixed">
        <parent link="base_link"/>
        <child link="standoff_l2"/>
        <origin xyz="-0.067 0.044 0.057"/>
    </joint>

    <link name="standoff_l1">
        <visual>
        <geometry><cylinder radius="0.0025" length="0.05"/></geometry>
        <material name="silver"><color rgba="0.15 0.15 0.15 1.0"/></material>
        </visual>
    </link>
    <joint name="standoff_l1_joint" type="fixed">
        <parent link="base_link"/>
        <child link="standoff_l1"/>
        <origin xyz="0.015 0.044 0.057"/>

    </joint>

        <link name="standoff_l3">
        <visual>
        <geometry><cylinder radius="0.0025" length="0.05"/></geometry>
        <material name="silver"><color rgba="0.15 0.15 0.15 1.0"/></material>
        </visual>
    </link>
    <joint name="standoff_l3_joint" type="fixed">
        <parent link="base_link"/>
        <child link="standoff_l3"/>
        <origin xyz="0.071 0.044 0.057"/>
    </joint>


<!-- ============== RIGHT ================== -->

