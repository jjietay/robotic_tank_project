<!-- ================================================ -->
<!--             GAZEBO MATERIAL COLORS               -->
<!-- ================================================ -->
<!-- Gazebo ignores URDF <material> tags — these      -->
<!-- <gazebo> blocks set the visual appearance in sim  -->

<gazebo reference="base_link">
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="platform">
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="left_drive">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
</gazebo>
<gazebo reference="right_drive">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
</gazebo>
<gazebo reference="left_bearing">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
</gazebo>
<gazebo reference="right_bearing">
    <material>Gazebo/Black</material>
    <mu1>1.5</mu1>
    <mu2>1.5</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
</gazebo>
<gazebo reference="lidar_link">
    <material>Gazebo/Grey</material>
</gazebo>


<!-- ================================================ -->
<!--          GAZEBO: DIFFERENTIAL DRIVE PLUGIN       -->
<!-- ================================================ -->
<!-- Subscribes to /cmd_vel, publishes /odom and      -->
<!-- broadcasts odom → base_link TF.                  -->
<!-- Both drive + bearing wheels are driven so the    -->
<!-- 4-wheel tank doesn't drag.                       -->

<gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <!-- Wheel joints — left side -->
        <left_joint>left_drive_joint</left_joint>
        <left_joint>left_bearing_joint</left_joint>

        <!-- Wheel joints — right side -->
        <right_joint>right_drive_joint</right_joint>
        <right_joint>right_bearing_joint</right_joint>

        <!-- Wheel geometry (from URDF) -->
        <wheel_separation>0.136</wheel_separation>
        <wheel_diameter>0.038</wheel_diameter>

        <!-- Limits -->
        <max_wheel_torque>5.0</max_wheel_torque>
        <max_wheel_acceleration>2.0</max_wheel_acceleration>

        <!-- Odometry -->
        <odometry_frame>odom</odometry_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>true</publish_odom_tf>
        <publish_wheel_tf>true</publish_wheel_tf>

        <!-- Topics -->
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>

        <!-- Update rate -->
        <update_rate>100.0</update_rate>
    </plugin>
</gazebo>


<!-- ================================================ -->
<!--          GAZEBO: LIDAR SENSOR PLUGIN             -->
<!-- ================================================ -->
<!-- Simulates the YD LIDAR X3 Pro: 360° scan,       -->
<!-- ~8m range, publishes sensor_msgs/LaserScan       -->
<!-- on /scan — same topic SLAM Toolbox expects.      -->

<gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>6.0</update_rate>
        <visualize>true</visualize>
        <ray>
            <scan>
                <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.12</min>
                <max>8.0</max>
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.01</stddev>
            </noise>
        </ray>
        <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
            <ros>
                <remapping>~/out:=/scan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
            <frame_name>lidar_link</frame_name>
        </plugin>
    </sensor>
</gazebo>


<!-- ================================================ -->
<!--           GAZEBO: IMU SENSOR PLUGIN              -->
<!-- ================================================ -->
<!-- Publishes sensor_msgs/Imu on /sensors/imu —      -->
<!-- same topic your real firmware publishes.          -->

<gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <imu>
            <angular_velocity>
                <x><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></x>
                <y><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></y>
                <z><noise type="gaussian"><mean>0</mean><stddev>0.0005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
                <x><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></x>
                <y><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></y>
                <z><noise type="gaussian"><mean>0</mean><stddev>0.005</stddev></noise></z>
            </linear_acceleration>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
            <ros>
                <remapping>~/out:=/sensors/imu</remapping>
            </ros>
            <frame_name>imu_link</frame_name>
            <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
    </sensor>
</gazebo>


</robot>
