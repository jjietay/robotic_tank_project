    </geometry>
    <material name="light_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
    </material>
    </visual>
    <collision>
        <geometry><cylinder radius="0.019" length="0.023"/></geometry>
    </collision>
    <inertial>
        <mass value="0.05"/>
        <inertia
            ixx="0.000016" ixy="0.0" ixz="0.0"
            iyy="0.000016" iyz="0.0" izz="0.000016"/>
    </inertial>
</link>
<joint name="left_bearing_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_bearing"/>
    <origin xyz="0.058 0.0686 0.001" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
</joint>

<!-- ============== RIGHT ================== -->
<link name="right_bearing">
    <visual>
    <geometry>
        <cylinder radius="0.019" length="0.023"/>
    </geometry>
    <material name="light_grey">
        <color rgba="0.15 0.15 0.15 1.0"/>
